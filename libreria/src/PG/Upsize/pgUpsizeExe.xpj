[PROJECT]
    COMPILE       = xpp
    COMPILE_FLAGS = /M/W/N/ES/Q/NOD/COFF/PRE
    DEBUG         = no
    GUI           = no
    LINKER        = alink
    LINK_FLAGS    = /PM:PM /out:..\..\..\output\lib200-2598\rel\pgupsize.exe
    RC_COMPILE    = arc
    RC_FLAGS      = /v
    OBJ_FORMAT    = COFF
    OBJ_DIR       = ..\..\..\output\lib200-2598\rel\obj
    PROJECT.XPJ

[PROJECT.XPJ]
    PGUPSIZE.EXE

[PGUPSIZE.EXE]
    pgUpsizeExe.prg
    pgUpsizeCliCompat.prg
    ..\Runtime\pgVdbIni.prg
    pgUpsizeConn.prg
    pgUpsizeXml.prg
    pgUpsize.prg
    ..\..\..\output\lib200-2598\rel\dblang.lib
    ..\..\..\output\lib200-2598\rel\vdbsee1s.lib
    ..\..\..\output\lib200-2598\rel\vdbsee1o.lib
    ..\..\..\output\lib200-2598\rel\vdbsee1x.lib
    kernel32.lib
    user32.lib
    msvcrt.lib
    winspool.lib
    comdlg32.lib
